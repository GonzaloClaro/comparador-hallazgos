# OpenAI: embeddings (text-embedding-3-large) y modelos gpt-* si se configuran
OPENAI_API_KEY=sk-...
# Anthropic: extracción y LLM-as-judge cuando MODELO_EXTRACCION es claude-*
ANTHROPIC_API_KEY=sk-ant-...
# Modelo de extracción/juez. "claude-*" usa Anthropic, otro nombre usa OpenAI.
MODELO_EXTRACCION=claude-opus-5-5
# Opcional: modelo de respaldo si MODELO_EXTRACCION falla por permisos.
MODELO_EXTRACCION_FALLBACK=
# Opcional: modelo solo para el juez semantico de matching (Etapa 4).
# Si queda vacio, usa MODELO_EXTRACCION.
MODELO_JUEZ_MATCHING=
# Pasada final de la Etapa 4: control de polaridad (Cumple vs No cumple) y
# juez de redaccion para descripcion/accion bajo el umbral de similitud (usa
# el mismo modelo que el juez de matching). false = solo embeddings + umbral.
JUEZ_REDACCION=true
# Checklist con cita literal verificada contra el PDF (un "cumple" sin cita
# verificada pasa a no verificable). false = checklist sin cita, como antes.
CITA_CHECKLIST=true
# Informes leidos por partes (no caben en una lectura): marcar = un "cumple"
# que respaldan solo algunas partes lleva un aviso con las paginas a revisar;
# bajar = ademas, los puntos que exigen revisar todo el informe pasan a no
# verificable. No cambia lo que se le pregunta al modelo.
CHECKLIST_UN_TRAMO=marcar
# Checklist por la API de Batch (solo modelos Claude): la misma llamada a mitad
# de precio, pero espera a que el lote termine (minutos a horas, tope 24 h).
# Para las rondas de medicion; false = llamada directa, como antes.
CHECKLIST_BATCH=false
# Emparejamiento de E4: si dos hallazgos del PDF reclaman la misma fila del
# Excel, la gana el de mayor confianza y el otro se reintenta sin ella; si la
# perdió un hallazgo que dice lo contrario (cumple / no cumple), el par que se
# queda con ella sale como emparejamiento dudoso. Encendido por defecto desde
# el 2026-10-26. false = emparejar en el orden de extracción, como antes.
ASIGNACION_GLOBAL=true
# Descripcion identica (M30): dentro del mismo pano y rele, el hallazgo del PDF y
# la fila del Excel con la misma descripcion (sin contar espacios ni mayusculas)
# se emparejan sin el juez LLM; con varias filas iguales, se reparten por accion.
# Encendido por defecto desde el 2026-10-27. false = como antes.
DESCRIPCION_IDENTICA=true
# Control de codigos (M28 V2): sobre el umbral, un codigo o numero cambiado entre
# el PDF y el Excel (50N -> 67N) se marca como diferencia sin LLM, como la
# polaridad. Encendido por defecto desde el 2026-10-27. false = como antes.
CONTROL_CODIGOS=true
# Copias del mismo origen (M34): cuando la fila del Excel y el hallazgo del PDF que
# aplican a varios panos se desdoblan los dos en una copia por tupla, las copias se igualan del lado
# seguro (la confianza mas baja y el "difiere" del juez de redaccion). Encendido
# por defecto desde el 2026-10-27. false = como antes.
UNIFICAR_COPIAS=true
# Justificar antes de elegir (M32): el juez de emparejamiento escribe la
# justificacion antes del indice y la confianza. Apagado por defecto. false = como antes.
JUEZ_JUSTIFICA_PRIMERO=false
# Carpeta del feedback del equipo revisor (fuera de runs/: la retención no lo borra).
# FEEDBACK_DIR=feedback
